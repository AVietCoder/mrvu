    employees,
    orders: [o1],
    order_items: [
      { id: uid(), order_id: "o1", product_id: "p1", qty: 2, unit_price: 2890000, discount: 280000, total: 5500000 },
    ],
    logs: [
      { id: uid(), employee_id: "e2", action: "create_order", detail: "HD000001", created_at: now() },
