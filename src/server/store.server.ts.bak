  ];

  return {
    branches: [b1, b2],
    categories: cats,
    products,
    stock,
    movements: [
      { id: uid(), type: "in", product_id: "p1", to_branch: "b1", qty: 16, unit_cost: 2200000, note: "Nhập từ NCC Mitsubishi", created_at: now() },
      { id: uid(), type: "out", product_id: "p1", from_branch: "b1", qty: 2, note: "Bán lẻ HD000001", created_at: now() },
