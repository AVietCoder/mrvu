# Turso (libsql) connection — server-side only
TURSO_DATABASE_URL=libsql://your-database-xxxx.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudinary (giữ nguyên nếu có dùng upload ảnh)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── ZALO OA / ZNS ────────────────────────────────────────────────────────
# ⚠️ Không biến nào dưới đây được đặt tiền tố VITE_. Tiền tố đó khiến Vite
#    nhúng thẳng giá trị vào bundle trình duyệt — ai mở DevTools cũng đọc được.

# Supabase service role — BYPASS TOÀN BỘ RLS. Lấy ở:
#   Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Khoá mã hoá token Zalo trong DB. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Đổi khoá này = mọi token đã lưu không giải mã được nữa, phải nối lại OA.
ZALO_TOKEN_SECRET=

# Ứng dụng trên Zalo Developers (developers.zalo.me → app của bạn)
ZALO_APP_ID=
ZALO_APP_SECRET=
# Phải trùng TUYỆT ĐỐI với Redirect URI đã khai trong app Zalo
ZALO_REDIRECT_URI=https://ten-mien-cua-ban/zalo/callback

# Secret bảo vệ endpoint /api/jobs/drain (pg_cron gọi vào). Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JOB_DRAIN_SECRET=

# ─── SEO STUDIO (/seo trong menu admin) ────────────────────────────────────
# Toàn bộ chạy phía server (src/lib/seo-studio). KHÔNG đặt tiền tố VITE_.

# Chuỗi kết nối Postgres của chính dự án Supabase này. Lấy ở:
#   Supabase Dashboard → Connect → Transaction pooler (cổng 6543), thay [YOUR-PASSWORD]
#   bằng mật khẩu database. Chạy sql_migration_v25_seo_studio.sql trước.
SEO_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Khoá mã hoá mật khẩu WordPress / token Custom API / file khoá Google tải lên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Đổi khoá này = các mật khẩu website đã lưu không đọc được nữa, phải nhập lại.
SEO_SECRET_KEY=

# Secret bảo vệ /seo-studio/cron (pg_cron gọi mỗi phút để chạy lịch tự đăng bài). Sinh như trên.
SEO_JOB_SECRET=

# ── Đăng nhập Google cho khu vực SEO (bắt buộc; thiếu thì SEO Studio bị khoá) ──
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
#   Authorized redirect URI:  https://ten-mien-cua-ban/seo-studio/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Địa chỉ gốc của POS (không có dấu / ở cuối), dùng để tạo redirect URI ở trên
SEO_PUBLIC_URL=https://ten-mien-cua-ban
# Email Google được vào SEO Studio, cách nhau bằng dấu phẩy
SEO_ALLOWED_EMAILS=admin@example.com

# ── DataForSEO (Volume, Rank, AI Overview, Backlink) — app.dataforseo.com → API Access ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Claude (viết bài, gợi ý AI) — console.anthropic.com → API Keys ──
ANTHROPIC_API_KEY=
# Không bắt buộc: đổi mô hình (mặc định claude-sonnet-5-5)
SEO_ANTHROPIC_MODEL=

# ── Pexels (ảnh miễn phí cho Autopost, không bắt buộc) — pexels.com/api ──
PEXELS_API_KEY=

# ── Google Search Console + GA4 (tab Search Console, không bắt buộc) ──
# Nội dung file JSON của service account (dán nguyên JSON trên một dòng, hoặc mã hoá base64).
# Để trống thì tải file lên trong tab Search Console → Kết nối (được lưu mã hoá).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Không bắt buộc: website và GA4 Property ID mặc định (chọn lại được trong giao diện)
SEO_GSC_SITE=
SEO_GA_PROPERTY=

# Không bắt buộc: thời gian chạy tối đa (giây) của /seo-studio/* trên Vercel. Mặc định 300
# (gói Hobby + Fluid Compute). Đặt 60 nếu dự án tắt Fluid Compute.
SEO_MAX_DURATION=

# Chỉ dùng khi chạy thử trên máy (localhost): 1 = bỏ qua đăng nhập Google. KHÔNG đặt trên Vercel.
SEO_DEV_NO_AUTH=
